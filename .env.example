# The host-side URL uses Saasy's loopback-only Compose database port.
# Inside the app container, Compose overrides DATABASE_URL with db:5432.
# For deployment, set DATABASE_URL to your managed Postgres provider.
DATABASE_URL="postgresql://postgres:CHOOSE_A_UNIQUE_PASSWORD@127.0.0.1:5435/saasy"

# Local Saasy Docker DB. Use the same URL-safe password as in DATABASE_URL.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHOOSE_A_UNIQUE_PASSWORD"
POSTGRES_DB="saasy"

# App: browser-visible private URL (not the internal Compose app address).
NEXT_PUBLIC_APP_URL="https://omarchy-home.tailcb326a.ts.net:8455"

# SEO (optional)
GOOGLE_SITE_VERIFICATION=""

# Auth
BETTER_AUTH_SECRET="your-secret-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI (Google)
GOOGLE_AI_API_KEY=""

# Payments (Polar.sh)
# Keep sandbox for local/dev resets. Use production only in deployed environments.
POLAR_SERVER="sandbox"
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ORGANIZATION_ID=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Background Jobs (Inngest - prod only)
INNGEST_SIGNING_KEY=""
