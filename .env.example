# Database
# Use a local Docker Postgres URL for development.
# For deployment, set DATABASE_URL to your managed Postgres provider (Neon, Supabase, etc.).
DATABASE_URL="postgresql://user:pass@localhost:5432/saasy"

# Local Docker DB (override per clone if needed)
DB_CONTAINER_NAME="saasy-db"
DB_PORT="5432"
DB_VOLUME_NAME="saasy_db_data"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="saasy"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SEO (optional)
GOOGLE_SITE_VERIFICATION=""

# Auth
BETTER_AUTH_SECRET="your-secret-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI (Google)
GOOGLE_AI_API_KEY=""

# Payments (Polar.sh)
# Keep sandbox for local/dev resets. Use production only in deployed environments.
POLAR_SERVER="sandbox"
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ORGANIZATION_ID=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Background Jobs (Inngest - prod only)
INNGEST_SIGNING_KEY=""
